{:paths ["src"]
 ;; Extracted from kotoba-lang/kotobase (ADR-2607201600 M6 decision 6): the code
 ;; graph is unrelated to the IStore core being retired, so it must not be
 ;; dissolved along with it. All-`.cljc`, no third-party deps.
 ;;
 ;; NOTE: this library is still an IStore CONSUMER (`kotobase.store` for the
 ;; seam, `kotobase.local` for the pure oracle). Extraction makes that coupling
 ;; explicit and gate-visible instead of internal; it does not remove it. This
 ;; repo is on the ADR-2607201600 M6 migration list (wave: docs+streams mixed).
 :deps {
        io.github.kotoba-lang/kotoba-core-contracts {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git" :git/sha "7d6a1183134fac7e8e2427f87d4250422b330563"}

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "b4ff9d8a56263030bc92539b101e1eeb2dbfce39"}
        io.github.kotoba-lang/abi {:git/url "https://github.com/kotoba-lang/abi.git"
                                   :git/sha "4dd0b7b9898cec5432bbe60c2904c1546e5f524a"}
        ;; Advanced from 142f3f7 so that `kotobase.execution-contract` and
        ;; `kotobase.evidence` are available: a query receipt now embeds the
        ;; version 1 ExecutionReceipt it is evidence of, and this repository
        ;; registers its own evidence planes because kotobase cannot carry a
        ;; carrier for records it does not write.
        io.github.kotoba-lang/kotobase {:git/url "https://github.com/kotoba-lang/kotobase.git"
                                        :git/sha "719839bd993ad50b2367e17371b10acbaefe9423"}}
 :aliases
 {:cljs-test {:extra-paths ["test"]
              :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
